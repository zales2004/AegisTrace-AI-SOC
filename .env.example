# ==========================================
# WAZUH INDEXER
# ==========================================
WAZUH_INDEXER_URL=https://YOUR_WAZUH_HOST:9200
WAZUH_INDEXER_USER=your_wazuh_username
WAZUH_INDEXER_PASSWORD=your_wazuh_password
WAZUH_VERIFY_TLS=false

# ==========================================
# VIRUSTOTAL
# ==========================================
VIRUSTOTAL_API_KEY=your_virustotal_api_key
VT_CACHE_TTL_SECONDS=YOUR_CACHE_TTL

# ==========================================
# OLLAMA
# ==========================================
OLLAMA_BASE_URL=http://YOUR_OLLAMA_HOST:11434
OLLAMA_MODEL=qwen2.5:1.5b

# ==========================================
# AEGISTRACE DATABASE
# ==========================================
AEGISTRACE_DB_PATH=data/aegistrace.db

# ==========================================
# FILE MONITORING
# ==========================================
AEGISTRACE_MONITOR_DIRS=YOUR_MONITORED_DIRECTORIES
AEGISTRACE_FILE_POLL_SECONDS=YOUR_POLL_INTERVAL
AEGISTRACE_MAX_FILE_MB=YOUR_MAX_FILE_SIZE

# ==========================================
# QUARANTINE SETTINGS
# ==========================================
AEGISTRACE_QUARANTINE_DIR=YOUR_QUARANTINE_DIRECTORY
AEGISTRACE_AUTO_QUARANTINE_MIN_ENGINES=YOUR_MINIMUM_ENGINE_COUNT
AEGISTRACE_AUTO_QUARANTINE_RATIO=YOUR_QUARANTINE_THRESHOLD
